# SnapQuote runs entirely on Mack's own server: PostgreSQL, the files and the app. Nothing is sent anywhere else.

# The database. Its name must start with snapquote_1026, so the old SnapQuote's database can never be touched.
DATABASE_URL=postgres://snapquote:CHANGE_ME@127.0.0.1:5432/snapquote_1026
# For npm run test:db and test:browser only; the tests wipe it. Must end in _test.
TEST_DATABASE_URL=postgres://snapquote:CHANGE_ME@127.0.0.1:5432/snapquote_1026_test

# Where attached files are kept (drawings, models, RFQ emails). Back this folder up with the database.
STORAGE_DIR=D:\SnapQuote\files

# 0.0.0.0 to be reachable from the plant network; 127.0.0.1 for this machine only.
HOST=0.0.0.0
# Not 3000 or 3003 (the old SnapQuote) and not 3100 (the Production Scheduler).
PORT=3200

# How long a sign-in lasts, in hours (a week by default).
SESSION_HOURS=168
