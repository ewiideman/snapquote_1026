{
  "name": "snapquote",
  "version": "0.1.0",
  "private": true,
  "description": "SnapQuote: RFQ quoting for Mack Molding, on-prem",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server/main.ts",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "db:migrate": "node --disable-warning=ExperimentalWarning src/cli/db-migrate.ts",
    "db:migrate:test": "node --disable-warning=ExperimentalWarning src/cli/db-migrate.ts --test",
    "user": "node --disable-warning=ExperimentalWarning src/cli/user.ts",
    "import:directory": "node --disable-warning=ExperimentalWarning src/cli/import-directory.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/unit/*.test.ts\"",
    "test:db": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/integration/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "check": "npm run typecheck && npm test",
    "test:browser": "npm run -s build:ui && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@kenjiuno/msgreader": "^1.28.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "mailparser": "^3.9.36",
    "nodemailer": "^10.0.15",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "6.0.3",
    "vite": "^8.3.2"
  }
}
